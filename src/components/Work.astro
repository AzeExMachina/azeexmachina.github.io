---
import { work } from '../data/work';
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <header data-reveal>
      <p class="eyebrow">Selected work</p>
      <h2 class="section-title" id="work-title">Heavy graphics, real systems</h2>
      <p class="section-lead">
        For the past ten years I’ve led the Unity and React teams at CT Innovation, building software where real-time 3D meets enterprise systems, from large interactive touch surfaces to live sensor data rendered in the browser
      </p>
    </header>

    <div class="work-grid">
      {
        work.map((item, i) => (
          <article class="work-card" data-reveal style={`--delay:${i * 0.1}s`}>
            <p class="work-kicker">{item.kicker}</p>
            <h3 class="work-title">{item.title}</h3>
            <p class="work-summary">{item.summary}</p>
            <ul class="work-highlights">
              {item.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <ul class="work-stack" aria-label="Technologies">
              {item.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in oklab, var(--wine) 55%, transparent), transparent 60%),
      var(--surface);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }

  .work-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: linear-gradient(90deg, var(--crimson), var(--peach));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .work-card:hover {
    border-color: color-mix(in oklab, var(--peach) 35%, transparent);
  }

  .work-card:hover::after {
    transform: scaleX(1);
  }

  .work-index {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    pointer-events: none;
  }

  .work-kicker {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--peach);
  }

  .work-title {
    font-size: var(--step-2);
    margin-top: 0.5rem;
  }

  .work-summary {
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .work-highlights {
    display: grid;
    gap: 0.6rem;
    margin-block: 1.5rem 2rem;
    padding: 0;
    list-style: none;
  }

  .work-highlights li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.95em;
  }

  .work-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.6rem;
    height: 2px;
    background: var(--crimson);
  }

  .work-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0;
    list-style: none;
  }
</style>
