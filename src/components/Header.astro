---
import { nav, site } from '../data/site';
---

<header class="header" data-header>
  <div class="container header-inner">
    <a class="logo" href="#top" aria-label={`${site.name}, back to top`}>
      <span class="logo-mark" aria-hidden="true">DA</span>
      <span class="logo-name">{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <a class="nav-resume" href={site.resume} download>Résumé</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .header.is-scrolled {
    background: color-mix(in oklab, var(--navy-900) 80%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.8rem;
    background: linear-gradient(135deg, var(--crimson), var(--wine));
    color: var(--peach);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .nav-list {
    display: flex;
    gap: clamp(0.75rem, 3vw, 2rem);
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-list {
    align-items: center;
  }

  .nav-list a:hover {
    color: var(--accent);
  }

  .nav-list .nav-resume {
    padding: 0.35rem 0.9rem;
    border: 1px solid color-mix(in oklab, var(--peach) 50%, transparent);
    border-radius: var(--radius-pill);
    color: var(--peach);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .nav-list .nav-resume:hover {
    background: var(--peach);
    color: var(--navy-900);
  }

  @media (max-width: 30rem) {
    .nav-list {
      gap: 0.6rem;
    }

    .nav-list a {
      font-size: 0.8rem;
    }

    .nav-list .nav-resume {
      padding: 0.25rem 0.6rem;
    }
  }

  @media (max-width: 40rem) {
    .logo-name {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
