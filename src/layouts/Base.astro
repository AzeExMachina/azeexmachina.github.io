---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} · ${site.role}`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#161e2f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      targets.forEach((el) => io.observe(el));

      // In-page links (#work, #top, …) scroll to their section without adding the hash to the URL.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
        const id = link?.getAttribute('href')?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        if (id === 'top') window.scrollTo({ top: 0 });
        else target.scrollIntoView();
        // Move keyboard focus to the section, as a normal anchor jump would.
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>

    <!-- GoatCounter analytics (cookie-free; skips localhost automatically) -->
    <script is:inline data-goatcounter="https://aze.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <script is:inline>
      // Track email, résumé downloads and outbound links as GoatCounter events.
      document.addEventListener('click', (e) => {
        const a = e.target instanceof Element && e.target.closest('a[href]');
        if (!a || !window.goatcounter || !window.goatcounter.count) return;
        const url = new URL(a.href, location.href);
        let path;
        if (url.protocol === 'mailto:') path = 'email';
        else if (a.hasAttribute('download')) path = 'download' + url.pathname;
        else if (url.origin !== location.origin) path = 'out/' + url.hostname + url.pathname;
        else return;
        const label = a.querySelector('h1, h2, h3, h4') || a;
        const title = label.textContent.replace(/[↗↓]/g, '').replace(/\s+/g, ' ').trim().slice(0, 80);
        window.goatcounter.count({ path, title, event: true });
      });
    </script>
  </body>
</html>
